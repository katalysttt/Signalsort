# --- AI provider (optional) ---------------------------------------------
# Without a key SignalSort uses its built-in rule-based engine (clearly labelled
# in the UI). Set ONE of these to switch on the LLM pipeline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Database (optional) ------------------------------------------------
# Leave empty to use embedded Postgres (PGlite) persisted to ./data/pg.
# Set to a Supabase / Postgres connection string for hosted storage.
DATABASE_URL=

# --- Access (optional) --------------------------------------------------
# Set a shared password to require a login before anyone can use the app.
# Leave empty for local development. The SDK's /api/track endpoint stays
# open (it is protected by the write key instead).
SIGNALSORT_PASSWORD=
