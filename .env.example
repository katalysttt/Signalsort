# --- AI provider (optional) ---------------------------------------------
# Without a key SignalSort uses its built-in rule-based engine (clearly labelled
# in the UI). Set ONE of these to switch on the LLM pipeline.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Database (optional) ------------------------------------------------
# Leave empty to use embedded Postgres (PGlite) persisted to ./data/pg.
# Set to a Supabase / Postgres connection string for hosted storage.
DATABASE_URL=
